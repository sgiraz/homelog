# Development Dockerfile with Vite hot-reload
# Node 22 matches prod (Dockerfile) and satisfies Vite 8's minimum (≥ 20.19
# or ≥ 22.12). Node 20-alpine often pinned to an older patch would break.
FROM node:24-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# npm ci is strict against package-lock.json so we catch lockfile drift
# early and don't accidentally resolve different versions inside the image.
RUN npm ci

# Source code will be mounted via volume
EXPOSE 5173

# Run Vite dev server with host flag for Docker
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
