# HomeLog Environment Configuration
# Copy this file to .env and update with your values

# ========================
# REQUIRED
# ========================

# JWT Secret — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# ========================
# OPTIONAL (sensible defaults)
# ========================

# Image tag — read by Docker Compose, not by the application. Leave it unset
# to run the current release. "rc" runs the latest release candidate, which
# is unreleased code: back up ./data first, because a downgrade afterwards is
# not supported once it has migrated the database.
# HOMELOG_TAG=latest

# Server
GIN_MODE=release        # debug | release
PORT=8080
DB_PATH=./data/homelog.db

# Max stored bill PDFs per household, in MB (default 500, 0 = unlimited).
# UPLOAD_QUOTA_MB=500

# Timezone
TZ=Europe/Rome

# CORS — comma-separated list of origins allowed to make cross-origin requests.
# Leave unset to allow only localhost dev origins (5173, 8080). In production
# the frontend is served by the same binary so CORS is usually not needed.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://homelog.example.com

# Refresh-token cookie — the session's long-lived credential travels in an
# HttpOnly cookie, never in localStorage. Its Secure flag is set automatically
# when the request arrives over HTTPS (directly or via X-Forwarded-Proto), so a
# plain-HTTP LAN install keeps working. Force it either way if your proxy does
# not forward that header.
# COOKIE_SECURE=true

# Password reset — when SMTP is not configured, the reset token is logged to
# the server log (self-hosted admin relays it out of band). Set to "true" ONLY
# in development to also return the token in the forgot-password JSON response.
# DO NOT enable in production.
# DEV_EXPOSE_RESET_TOKEN=false

# Usage statistics — only read when DEMO_MODE is on, and only if you set it.
# The value is a GoatCounter site code (the "xxx" in xxx.goatcounter.com): the
# demo frontend then reports cookieless, aggregate pageviews to that account.
# Leave it unset and nothing is loaded and nothing is sent, which is the case
# for every self-hosted install. Never point it at someone else's site code.
# DEMO_GOATCOUNTER_SITE=my-demo

# Demo mode — turns this instance into the public showcase demo: a single
# shared account (demo@homelog.app / demo) is seeded at startup, the dataset is
# wiped and re-seeded every hour, a "Demo mode" banner is shown, and
# destructive operations (password change, account deletion, admin user
# management) return 403. NEVER enable on a real deployment with your own data.
# DEMO_MODE=true
