# Development Dockerfile with hot-reload using Air
# air v1.67+ requires go >= 1.26, hence the 1.26 base image (backend/go.mod
# itself only needs go 1.25.0, so this is just a newer, compatible toolchain).
FROM golang:1.26-alpine AS base

# Install dependencies — single layer, cached unless base image changes
RUN apk add --no-cache git gcc musl-dev sqlite-dev poppler-utils && \
    go install github.com/air-verse/air@latest && \
    go install github.com/go-delve/delve/cmd/dlv@latest

WORKDIR /app

# Copy go mod files first (cached unless go.mod/go.sum change)
COPY go.mod go.sum ./
RUN go mod download

# Source code will be mounted via volume
WORKDIR /app/src

EXPOSE 8080

# Run with Air for hot-reload
CMD ["air", "-c", ".air.toml"]
