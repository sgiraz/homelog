# HomeLog Environment Configuration
# Copy this file to .env and update with your values

# ========================
# REQUIRED
# ========================

# JWT Secret — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret

# ========================
# OPTIONAL (sensible defaults)
# ========================

# Server
GIN_MODE=release        # debug | release
PORT=8080
DB_PATH=./data/homelog.db

# Timezone
TZ=Europe/Rome

# CORS — comma-separated list of origins allowed to make cross-origin requests.
# Leave unset to allow only localhost dev origins (5173, 8080). In production
# the frontend is served by the same binary so CORS is usually not needed.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://homelog.example.com

# Password reset — when SMTP is not configured, the reset token is logged to
# the server log (self-hosted admin relays it out of band). Set to "true" ONLY
# in development to also return the token in the forgot-password JSON response.
# DO NOT enable in production.
# DEV_EXPOSE_RESET_TOKEN=false

# Demo mode — turns this instance into the public showcase demo: a single
# shared account (demo@homelog.app / demo) is seeded at startup, the dataset is
# wiped and re-seeded every hour, a "Demo mode" banner is shown, and
# destructive operations (password change, account deletion, admin user
# management) return 403. NEVER enable on a real deployment with your own data.
# DEMO_MODE=true
